# Copia este archivo a `.env` (local) o configúralo en Vercel por ambiente.
# Nunca commitees valores reales.

# --- Base de datos (Neon / PostgreSQL) --------------------------------------
# DATABASE_URL: conexión POOLED (host con `-pooler`), la que usa la app.
# DIRECT_URL:   conexión DIRECTA, la que usan las migraciones de Prisma.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/nutria?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host.region.aws.neon.tech/nutria?sslmode=require"

# --- E2E con mutaciones ------------------------------------------------------
# Usa una base desechable y exclusiva para Playwright. La configuración rechaza
# arrancar si falta cualquiera de estas variables y nunca reutiliza DATABASE_URL.
E2E_DATABASE_URL="postgresql://usuario:password@localhost:5432/nutria_test"
# Cámbialo deliberadamente a true solo cuando esa base se pueda crear y limpiar.
E2E_ALLOW_DB_MUTATION=false
# Alternativa para infra cuyo host/base no puede contener test|preview|branch:
# valor exacto "<host>:<puerto>/<base>" de E2E_DATABASE_URL.
E2E_DATABASE_ID=
# No la configures a mano: `playwright.config.ts` define EMAIL_OUTBOX_FILE durante
# los E2E para que el correo se anexe a un archivo en lugar de salir por Resend.
# Fuera de los E2E debe estar ausente; con ella definida no se envía correo real.

# --- Autenticación (Auth.js) ------------------------------------------------
# Genera el secreto con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000
AUTH_URL=http://localhost:3000
# OAuth de Google (opcional). Sin estas variables solo se ofrece email+contraseña.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Correo transaccional (Resend) ------------------------------------------
# Sin RESEND_API_KEY, en desarrollo los enlaces de verificación se imprimen en
# la consola del servidor en lugar de enviarse por correo.
RESEND_API_KEY=
EMAIL_FROM="nutria <no-reply@tudominio.mx>"

# --- Tareas programadas (Vercel Cron, fase 6) --------------------------------
# Secreto que Vercel Cron manda como `Authorization: Bearer <CRON_SECRET>`.
# Genera uno con: openssl rand -base64 32
# Sin esta variable las rutas de /api/v1/cron/* responden 503 y no corren: dejar
# abierto el envío de recordatorios lo convertiría en un amplificador de correo.
CRON_SECRET=

# --- IA (Anthropic / Claude) -------------------------------------------------
# API key de https://console.anthropic.com/settings/keys ("sk-ant-api03-...").
# Solo se usa en el servidor, nunca se expone al navegador ni como NEXT_PUBLIC_*.
# Sin esta variable, las funciones de IA responden 503 AI_NOT_CONFIGURED.
#
# Modelos por tarea (apps/web/src/server/ai/config.ts):
#   claude-sonnet-5   → borrador de plan, receta, resumen clínico
#   claude-haiku-4-5  → sugerencia de respuesta, plan de actividad
# Cuota por plan: Free 15 generaciones/mes, Pro 150, Clínica 500.
ANTHROPIC_API_KEY=

# --- Cifrado de datos clínicos (fase 8) -------------------------------------
# Clave de 32 bytes en base64: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Base de alimentos (fase 3) ---------------------------------------------
# Llave gratuita de USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup.html
# Solo la necesita `npm run db:import:usda`, que actualiza el catálogo versionado
# en prisma/seed/usda/alimentos-usda.json. Sin ella se usa DEMO_KEY, con cupo
# muy limitado. La siembra (`npm run db:seed`) no requiere red ni esta llave.
USDA_API_KEY=

# Vercel Blob: almacena las imágenes de los alimentos (Storage > Blob > Tokens).
# Solo la necesita `npm run db:imagenes`. Sin imagen, la UI muestra el ícono
# del grupo de equivalentes.
BLOB_READ_WRITE_TOKEN=
