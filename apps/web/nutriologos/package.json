{
  "name": "nutriologos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "jest",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:import:usda": "tsx prisma/seed/usda/importar.ts",
    "db:import:off": "tsx prisma/seed/off/importar.ts",
    "db:imagenes": "tsx prisma/seed/imagenes.ts",
    "db:encrypt": "tsx scripts/encrypt-clinical-data.ts --execute",
    "db:encrypt:check": "tsx scripts/encrypt-clinical-data.ts",
    "launch:check": "tsx --env-file=.env scripts/check-production-readiness.ts",
    "pilot:status": "tsx --env-file=.env scripts/pilot-status.ts",
    "test:load": "tsx scripts/load/smoke.ts",
    "test:load:k6": "k6 run scripts/load/k6-smoke.js",
    "postinstall": "prisma generate",
    "ai:check": "tsx --env-file=.env scripts/verificar-ia.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@nutria/shared": "*",
    "@nutria/ui-tokens": "*",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.68.0",
    "@tanstack/react-query": "^5.62.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.469.0",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.0",
    "stripe": "^19.3.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
