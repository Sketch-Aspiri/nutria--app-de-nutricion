{
  "name": "nutriologos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema ../../../packages/servidor/prisma/schema.prisma && next build",
    "start": "next start",
    "test": "jest",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate --schema ../../../packages/servidor/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../../packages/servidor/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../../../packages/servidor/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema ../../../packages/servidor/prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../../../packages/servidor/prisma/schema.prisma",
    "db:seed": "tsx ../../../packages/servidor/prisma/seed/index.ts",
    "db:import:usda": "tsx ../../../packages/servidor/prisma/seed/usda/importar.ts",
    "db:import:off": "tsx ../../../packages/servidor/prisma/seed/off/importar.ts",
    "db:imagenes": "tsx ../../../packages/servidor/prisma/seed/imagenes.ts",
    "db:encrypt": "tsx ../../../packages/servidor/scripts/encrypt-clinical-data.ts --execute",
    "db:encrypt:check": "tsx ../../../packages/servidor/scripts/encrypt-clinical-data.ts",
    "launch:check": "tsx --env-file=.env ../../../packages/servidor/scripts/check-production-readiness.ts",
    "pilot:status": "tsx --env-file=.env ../../../packages/servidor/scripts/pilot-status.ts",
    "test:load": "tsx ../../../packages/servidor/scripts/load/smoke.ts",
    "test:load:k6": "k6 run ../../../packages/servidor/scripts/load/k6-smoke.js",
    "postinstall": "prisma generate --schema ../../../packages/servidor/prisma/schema.prisma",
    "ai:check": "tsx --env-file=.env ../../../packages/servidor/scripts/verificar-ia.ts"
  },
  "dependencies": {
    "@nutria/servidor": "*",
    "@nutria/shared": "*",
    "@nutria/ui-tokens": "*",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.68.0",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.469.0",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
