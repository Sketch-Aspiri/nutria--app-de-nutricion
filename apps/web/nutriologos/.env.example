# Copia este archivo a `.env` (local) o configúralo en Vercel por ambiente.
# Nunca commitees valores reales.

# --- Base de datos (Neon / PostgreSQL) --------------------------------------
# DATABASE_URL: conexión POOLED (host con `-pooler`), la que usa la app.
# DIRECT_URL:   conexión DIRECTA, la que usan las migraciones de Prisma.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/nutria?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host.region.aws.neon.tech/nutria?sslmode=require"

# --- E2E con mutaciones ------------------------------------------------------
# Usa una base desechable y exclusiva para Playwright. La configuración rechaza
# arrancar si falta cualquiera de estas variables y nunca reutiliza DATABASE_URL.
E2E_DATABASE_URL="postgresql://usuario:password@localhost:5432/nutria_test"
# Cámbialo deliberadamente a true solo cuando esa base se pueda crear y limpiar.
E2E_ALLOW_DB_MUTATION=false
# Alternativa para infra cuyo host/base no puede contener test|preview|branch:
# valor exacto "<host>:<puerto>/<base>" de E2E_DATABASE_URL.
E2E_DATABASE_ID=
# No la configures a mano: `playwright.config.ts` define EMAIL_OUTBOX_FILE durante
# los E2E para que el correo se anexe a un archivo en lugar de salir por Resend.
# Fuera de los E2E debe estar ausente; con ella definida no se envía correo real.

# --- Autenticación (Auth.js) ------------------------------------------------
# Genera el secreto con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000
AUTH_URL=http://localhost:3000
# OAuth de Google (opcional). Sin estas variables solo se ofrece email+contraseña.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Correo transaccional (Resend) ------------------------------------------
# Sin RESEND_API_KEY, en desarrollo los enlaces de verificación se imprimen en
# la consola del servidor en lugar de enviarse por correo.
RESEND_API_KEY=
EMAIL_FROM="nutria <no-reply@tudominio.mx>"

# --- Tareas programadas (Vercel Cron, fase 6) --------------------------------
# Secreto que Vercel Cron manda como `Authorization: Bearer <CRON_SECRET>`.
# Genera uno con: openssl rand -base64 32
# Sin esta variable las rutas de /api/v1/cron/* responden 503 y no corren: dejar
# abierto el envío de recordatorios lo convertiría en un amplificador de correo.
CRON_SECRET=

# --- IA (Anthropic / Claude) -------------------------------------------------
# API key de https://console.anthropic.com/settings/keys ("sk-ant-api03-...").
# Solo se usa en el servidor, nunca se expone al navegador ni como NEXT_PUBLIC_*.
# Sin esta variable, las funciones de IA responden 503 AI_NOT_CONFIGURED.
#
# Modelos por tarea (packages/servidor/src/server/ai/config.ts):
#   claude-sonnet-5   → borrador de plan, receta, resumen clínico
#   claude-haiku-4-5  → sugerencia de respuesta, plan de actividad
# Cuota por plan: Free 15 generaciones/mes, Pro 150, Clínica 500.
ANTHROPIC_API_KEY=

# --- Cifrado de datos clínicos (fase 8) -------------------------------------
# Clave de 32 bytes en base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Identificador no secreto de la clave activa (ej. `prod-2026-07`).
ENCRYPTION_KEY_ID=
# Rotación: lista `id:clave-base64` separada por comas. Retírala solo después
# de volver a cifrar todos los registros con la clave activa.
ENCRYPTION_PREVIOUS_KEYS=

# --- Observabilidad y protección distribuida (fase 8) -----------------------
# DSN server-only y DSN público del mismo proyecto. El scrubber elimina
# contenido clínico, usuarios, cuerpos, cookies, correos e identificadores.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Tracing permanece desactivado: los spans no deben transportar datos clínicos.
SENTRY_TRACES_SAMPLE_RATE=0

# Redis REST de Upstash para límites compartidos entre instancias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secreto independiente para HMAC de correos/IP antes de enviarlos a Redis.
# Mínimo 32 caracteres; puede generarse con `openssl rand -base64 32`.
RATE_LIMIT_HASH_KEY=

# --- Privacidad (revisión legal requerida antes del lanzamiento comercial) --
PRIVACY_RESPONSIBLE_NAME=
PRIVACY_RESPONSIBLE_ADDRESS=
PRIVACY_CONTACT_EMAIL=

# --- Base de alimentos (fase 3) ---------------------------------------------
# Llave gratuita de USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup.html
# Solo la necesita `npm run db:import:usda`, que actualiza el catálogo versionado
# en packages/servidor/prisma/seed/usda/alimentos-usda.json. Sin ella se usa DEMO_KEY, con cupo
# muy limitado. La siembra (`npm run db:seed`) no requiere red ni esta llave.
USDA_API_KEY=

# Open Food Facts exige un User-Agent identificable con contacto o URL.
# Ejemplo: Nutria/1.0 (privacidad@tudominio.mx)
OFF_USER_AGENT=
OFF_MAX_PRODUCTS=300

# Vercel Blob: almacena las imágenes de los alimentos (Storage > Blob > Tokens).
# Solo la necesita `npm run db:imagenes`. Sin imagen, la UI muestra el ícono
# del grupo de equivalentes.
BLOB_READ_WRITE_TOKEN=

# --- Suscripciones con Stripe (fase 7) --------------------------------------
# BILLING_MODE decide si los planes y sus topes están vigentes:
#   beta        → (predeterminado) TODAS las cuentas son Free y SIN LÍMITES:
#                 pacientes, plantillas y generaciones de IA ilimitadas, PDF con
#                 marca propia incluido. El checkout responde 409 y la página de
#                 suscripción muestra los planes como "próximamente".
#   produccion  → entran en vigor los topes de la sección 9 del plan V2
#                 (Free: 3 pacientes, 15 IA/mes, sin marca blanca).
# Mientras dure la beta con nutriólogos piloto, déjalo en beta o sin definir.
BILLING_MODE=beta

# Llaves del panel de Stripe (Developers > API keys). Usa las de modo prueba
# (sk_test_...) hasta que el flujo esté validado de punta a punta.
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook. Cada endpoint tiene el suyo: el de
# `stripe listen` (local) NO sirve en producción y viceversa.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_...) de los productos creados en Stripe, en MXN y recurrentes.
# Un plan sin su price id configurado aparece como "próximamente" y no se puede
# contratar; el checkout jamás inventa un precio.
STRIPE_PRICE_PRO_MENSUAL=
STRIPE_PRICE_PRO_ANUAL=
STRIPE_PRICE_CLINICA_MENSUAL=

# URL pública a la que Stripe devuelve al usuario tras el pago. Si no se define,
# se usa AUTH_URL, luego el dominio de Vercel, y por último http://localhost:3000
APP_URL=

# --- Cohorte piloto ----------------------------------------------------------
# Exactamente 3–5 correos de nutriólogos que aceptaron participar. La utilidad
# `npm run pilot:status` solo muestra alias y nunca imprime estas direcciones.
PILOT_EMAILS=
