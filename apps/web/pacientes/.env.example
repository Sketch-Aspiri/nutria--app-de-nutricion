# Copia este archivo a `.env` (local) o configúralo en Vercel por ambiente.
# Nunca commitees valores reales.
#
# La app del paciente comparte base de datos, secreto de sesión y clave de
# cifrado con el panel del nutriólogo: son dos superficies sobre los mismos
# datos, no dos sistemas. Lo que NO comparte son el dominio ni la cookie.

# --- Base de datos (la MISMA que usa el panel) -------------------------------
# Las migraciones las corre solo el proyecto `nutriologos` (§11 del plan): dos
# despliegues simultáneos competirían por el bloqueo de migración.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/nutria?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host.region.aws.neon.tech/nutria?sslmode=require"

# --- Autenticación (Auth.js) -------------------------------------------------
# MISMO valor que en el panel: las dos apps validan tokens del mismo emisor.
AUTH_SECRET=
# Dominio propio de esta app. En local corre en el puerto 3001.
AUTH_URL=http://localhost:3001

# --- Correo transaccional ----------------------------------------------------
# La invitación la envía el panel; aquí se usa para el aviso interno de alta
# (la activación de la cuenta ocurre en esta app) y la recuperación de contraseña.
#
# MISMAS credenciales que el panel. En la fase de prueba, SMTP de un buzón propio
# (Gmail pide contraseña de aplicación); más adelante, Resend con dominio propio.
# Si hay SMTP configurado se usa ese y se ignora Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
# Con SMTP debe ser el MISMO buzón de SMTP_USER.
EMAIL_FROM="nutria <no-reply@tudominio.mx>"

# MISMO buzón interno que el panel: recibe un aviso cuando un paciente activa su
# cuenta. Del paciente solo va el correo enmascarado y el consultorio, nunca su
# nombre ni un dato clínico.
ADMIN_NOTIFY_EMAIL=

# --- IA del paciente (fase 5) ------------------------------------------------
# Coach, estimación de comida y sustitución de ingrediente. La llave solo se usa
# en el servidor: el prototipo la exponía en el navegador y eso no se repite.
ANTHROPIC_API_KEY=

# --- Cifrado de datos clínicos ----------------------------------------------
# MISMA clave que el panel: lee notas cifradas del mismo esquema.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=
ENCRYPTION_PREVIOUS_KEYS=

# --- Fotos de comida (Vercel Blob) ------------------------------------------
# Sin esta variable, POST /api/v1/me/photos responde 503 y el registro por foto
# queda deshabilitado; el resto de la app sigue funcionando.
BLOB_READ_WRITE_TOKEN=

# --- Observabilidad y límites distribuidos -----------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0

# Redis REST de Upstash para límites compartidos entre instancias. Sin estas
# variables el limitador es en memoria y no se comparte entre despliegues.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_KEY=

# --- SIN claves de Stripe ----------------------------------------------------
# El paciente no paga nada en la V1 (§11 del plan). Si algún día aparecen aquí,
# es que alguien montó rutas de cobro en la app equivocada.
