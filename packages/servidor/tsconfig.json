{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["jest", "node"],
    // El código de este paquete conserva los imports `@/…` con los que nació
    // dentro de la app. Aquí el alias apunta a su propio `src`, y como el
    // paquete replica el layout que tenía la app (`server/`, `config/`,
    // `domain/`, `components/`), resuelve solo y se type-checkea aislado.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "prisma", "scripts"],
  "exclude": ["node_modules"]
}
